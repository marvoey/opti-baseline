        {
          "name": "MediaAlignment",
          "displayName": "Media Alignment",
          "type": "PropertyString",
          "description": "Left or Right"
        },
        {
          "name": "LeftContentArea",
          "displayName": "Left Content",
          "type": "PropertyContentArea"
        },
        {
          "name": "RightContentArea",
          "displayName": "Right Content",
          "type": "PropertyContentArea"
        }
      ]
    },
    {
      "name": "RichTextBlock",
      "displayName": "Rich Text Block",
