{
  "contentTypes": [
    {
      "name": "EventLandingPage",
      "displayName": "Event Landing Page",
      "description": "Standard landing page used for SFA Homepage, FancyFaire, and Awards pages.",
      "type": "PageType",
      "properties": [
        {
          "name": "Title",
          "displayName": "Meta Title",
          "type": "PropertyString",
          "required": true
        },
        {
          "name": "MainContentArea",
          "displayName": "Main Content Area",
          "description": "Drag and drop layout and content blocks here.",
          "type": "PropertyContentArea",
          "required": false
        },
        {
          "name": "SidebarContentArea",
          "displayName": "Sidebar Content Area",
          "description": "Used for sidebar navigation and ads on pages like sofi Awards.",
          "type": "PropertyContentArea",
          "required": false
        }
      ]
    },
    {
      "name": "HeroBannerBlock",
      "displayName": "Hero Banner Block",
      "description": "Full width hero with optional video background, text, and CTAs.",
      "type": "BlockType",
      "properties": [
        {
          "name": "Heading",
          "displayName": "Heading (H1)",
          "type": "PropertyString"
        },
        {
          "name": "Subtext",
          "displayName": "Subtext",
          "type": "PropertyXhtmlString"
        },
        {
          "name": "BackgroundImage",
          "displayName": "Background Image",
          "type": "PropertyContentReference"
        },
        {
          "name": "BackgroundVideoUrl",
          "displayName": "Background Video URL",
          "type": "PropertyUrl"
        },
        {
          "name": "PrimaryCtaLink",
