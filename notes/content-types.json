        },
        {
          "name": "Message",
          "displayName": "Alert Message",
          "type": "PropertyXhtmlString"
        },
        {
          "name": "ThemeStyle",
          "displayName": "Theme Style",
          "type": "PropertyString"
        }
      ]
    },
    {
      "name": "MetricCardBlock",
      "displayName": "Metric / KPI Card",
