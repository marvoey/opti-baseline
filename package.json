{
  "name": "nextjs-banner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "predev": "npm run gen:locales",
    "build": "next build",
    "prebuild": "npm run gen:locales",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint",
    "gen:locales": "node scripts/generate-locales.mjs",
    "cms:push": "npx @optimizely/cms-cli config push optimizely.config.mjs",
    "cms:push:prgv": "npx @optimizely/cms-cli config push optimizely.config.progressive.mjs",
    "cms:import:policies": "node scripts/import-policies.mjs",
    "cms:import:standard-instructions": "node seed/scripts/import-standard-instructions.mjs",
    "cms:import:handling-notes:personal-auto": "node seed/scripts/import-handling-notes.mjs",
    "cms:import:handling-notes:home": "node seed/scripts/import-handling-notes-home.mjs",
    "cms:import:scripting-blocks:personal-auto": "node seed/scripts/import-scripting-blocks-personal-auto.mjs",
    "cms:publish:policies": "node scripts/publish-policies.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "screenshot:click": "node scripts/screenshot-click.mjs",
    "ngrok": "sh scripts/ngrok.sh"
  },
  "dependencies": {
    "@microlink/react-json-view": "^1.31.22",
    "@optimizely/cms-cli": "^2.0.0",
    "@optimizely/cms-sdk": "^2.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "lucide-react": "^1.18.0",
    "marked": "^18.0.5",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "spectacle": "^10.2.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@optimizely-opal/opal-tools-sdk": "^0.1.35-dev",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "puppeteer-core": "^25.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "yarn@4.17.0"
}
