{
  "name": "nextjs-banner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "predev": "npm run gen:locales",
    "build": "next build",
    "prebuild": "npm run gen:locales",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint",
    "gen:locales": "node scripts/generate-locales.mjs",
    "cms:push": "npx @optimizely/cms-cli config push optimizely.config.mjs",
    "cms:push:type": "node scripts/push-content-types.mjs",
    "cms:check": "node scripts/check-content-types.mjs",
    "schema:pull": "node scripts/fetch-openapi.mjs",
    "seed:experience": "node scripts/seed-experience.mjs",
    "seed:library:dr": "node scripts/seed-paragraphs.mjs seeds/library/discover-recommend/items.json",
    "seed:heroes:dr": "node scripts/seed-heroes.mjs",
    "seed:library:eg": "node scripts/seed-paragraphs.mjs seeds/library/educate-govern/items.json",
    "seed:library:st": "node scripts/seed-paragraphs.mjs seeds/library/simulate-transact/items.json"
  },
  "dependencies": {
    "@optimizely/cms-cli": "^2.0.0",
    "@optimizely/cms-sdk": "^2.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shiki": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
