{
  "name": "nextjs-banner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev --webpack",
    "predev": "npm run gen:locales",
    "build": "next build",
    "prebuild": "npm run gen:locales",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint",
    "gen:locales": "node scripts/generate-locales.mjs",
    "cms:push": "node --env-file=.env scripts/cms-push.mjs",
    "cms:push:all": "node --env-file=.env scripts/cms-push.mjs --all",
    "schema:pull": "node scripts/fetch-openapi.mjs",
    "seed:hero": "node scripts/seed-atomic-hero.mjs",
    "cms:check": "node --env-file=.env scripts/check-content-types.mjs",
    "cms:align": "node --env-file=.env scripts/cms-align.mjs",
    "cms:e2e": "node --env-file=.env scripts/cms-e2e.mjs",
    "cms:bulk": "node --env-file=.env scripts/cms-bulk.mjs",
    "site:new": "node --env-file=.env scripts/site-new.mjs",
    "site:new:local": "node --env-file=.env scripts/site-new-local.mjs",
    "guide:setup": "node --env-file=.env scripts/guide-setup.mjs",
    "guide:facilitator": "node --env-file=.env scripts/guide-facilitator.mjs",
    "mark-tools:token": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64url'))\"",
    "test:mark-tools": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"lib/mark-tools/__tests__/*.test.ts\""
  },
  "dependencies": {
    "@optimizely/cms-cli": "^2.0.0",
    "@optimizely/cms-sdk": "^2.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "lucide-react": "^1.18.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
