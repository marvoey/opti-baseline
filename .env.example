# Optimizely CMS SaaS — copy to .env and fill in real values (.env is gitignored).

# Port the server listens on (npm run dev / npm run start). Defaults to 3009 if unset.
PORT=3009

# Default locale. Serves clean URLs (no /en/ prefix); other CMS-enabled locales
# get a /<segment>/ prefix. Must match the CMS default locale.
OPTIMIZELY_DEFAULT_LOCALE=en

# --- Build-time: pushing content types + generating the locale list ---------
# Used by @optimizely/cms-cli (`npm run config:push`) and scripts/generate-locales.mjs
# (`npm run gen:locales`). Create an API client in CMS admin → Settings → API Clients.
OPTIMIZELY_CMS_URL=https://your-instance.cms.optimizely.com/
OPTIMIZELY_CMS_CLIENT_ID=
OPTIMIZELY_CMS_CLIENT_SECRET=
# Content Management API gateway. Optional — defaults to https://api.cms.optimizely.com.
# Used by the /admin content-type inspector (and the CLI) to read/push content types.
# OPTIMIZELY_CMS_API_URL=https://api.cms.optimizely.com

# --- Runtime: fetching published/preview content via Optimizely Graph -------
# REQUIRED — the app fails fast at startup (lib/env.ts) without this. Found in
# the Graph admin. The gateway URL is optional; the SDK defaults to the value below.
OPTIMIZELY_GRAPH_SINGLE_KEY=
OPTIMIZELY_GRAPH_GATEWAY=https://cg.optimizely.com/content/v2

# Optional. Content is indexed in Optimizely Graph under the real deployed
# domain (_metadata.url.base), never "localhost" — so in local dev (lib/siteHost.ts)
# the request host is swapped for this origin (e.g. https://ontic.optimoey.com)
# to scope Graph lookups to the right site. Without it, local dev falls back to
# scoping by "localhost" itself, which won't match any indexed content.
DEPLOYED_URL=

# --- Preview / on-page editing (app/preview/page.tsx) -----------------------
# The preview route loads communicationinjector.js from OPTIMIZELY_CMS_URL (above)
# to bridge the CMS editor iframe to this app, so no extra var is needed here.

# --- Optional: Optimizely Web Experimentation / Personalization -------------
# Public — ends up in the client snippet URL (https://cdn.optimizely.com/js/<id>.js).
# Leave blank to skip loading the Web snippet entirely.
NEXT_PUBLIC_OPTIMIZELY_WEB_SNIPPET_ID=

# --- Mark (Opal) round trip: Ask Liberty -------------------------------------
# See docs/ask-liberty-mark-roundtrip-plan.md. All of these are server-only.
# The on/off switch is the "Send questions to Mark" checkbox on the Ask Liberty
# page in the CMS; these values only say whether the server CAN do it.

# Webhook trigger of the Mark workflow agent (Agents → workflow → Webhook trigger).
# The trigger's auth header must be "Authorization" with "Bearer <token>".
OPAL_WEBHOOK_URL=
OPAL_WEBHOOK_TOKEN=

# Bearer token Mark sends when it calls /api/tools/liberty_ask. Paste the same
# value into Mark → Connectors → Registries. Any long random string:
#   openssl rand -hex 32
# If this is empty the tool route refuses every request.
OPAL_TOOL_TOKEN=

# A DEDICATED CMS API client for this feature (CMS admin → Settings → API Clients),
# separate from OPTIMIZELY_CMS_CLIENT_ID/SECRET so it can be revoked on its own.
ASK_MARK_CMS_CLIENT_ID=
ASK_MARK_CMS_CLIENT_SECRET=

# Key of the CMS folder "Ask Liberty Mark results" that holds the short-lived
# reply items (create it once in the CMS asset panel).
ASK_MARK_RESULTS_FOLDER_KEY=

# Non-production only. "on" makes /api/opal/stub act as Mark, so the whole round
# trip can be tested and probed without Mark. Ignored on Vercel Production.
ASK_MARK_STUB=off

# Optional. Questions per minute per client address (default 10). Only raise this
# for the reliability probe on a Preview deployment: scripts/probe-mark-roundtrip.mjs
# ASK_MARK_RATE_LIMIT=10
