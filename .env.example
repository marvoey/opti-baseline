# Optimizely Graph endpoint (leave as-is unless Optimizely tells you otherwise)
OPTIMIZELY_GRAPH_GATEWAY=https://cg.optimizely.com

# Option A - PUBLISHED content only (public, read-only).
OPTIMIZELY_GRAPH_SINGLE_KEY=

# Option B - ALL content incl. drafts (admin). Server-side only, never expose in the browser.
OPTIMIZELY_GRAPH_APP_KEY=
OPTIMIZELY_GRAPH_SECRET=

# Optional. "single" or "basic". Default: basic if APP_KEY+SECRET are set, otherwise single.
GRAPH_AUTH_MODE=

# Optional. Locale to render (the function filters on _metadata.locale). Default: en
CONTENT_LOCALE=en
