# Optimizely CMS SaaS — copy to .env and fill in real values (.env is gitignored).

# Port the server listens on (npm run dev / npm run start). Defaults to 3009 if unset.
PORT=3009

# Default locale. Serves clean URLs (no /en/ prefix); other CMS-enabled locales
# get a /<segment>/ prefix. Must match the CMS default locale.
OPTIMIZELY_DEFAULT_LOCALE=en

# --- Build-time: pushing content types + generating the locale list ---------
# Used by @optimizely/cms-cli (`npm run config:push`) and scripts/generate-locales.mjs
# (`npm run gen:locales`). Create an API client in CMS admin → Settings → API Clients.
OPTIMIZELY_CMS_URL=https://your-instance.cms.optimizely.com/
OPTIMIZELY_CMS_CLIENT_ID=
OPTIMIZELY_CMS_CLIENT_SECRET=

# --- Runtime: fetching published/preview content via Optimizely Graph -------
# REQUIRED — the app fails fast at startup (lib/env.ts) without this. Found in
# the Graph admin. The gateway URL is optional; the SDK defaults to the value below.
OPTIMIZELY_GRAPH_SINGLE_KEY=
OPTIMIZELY_GRAPH_GATEWAY=https://cg.optimizely.com/content/v2

# --- Preview / on-page editing (app/preview/page.tsx) -----------------------
# The preview route loads communicationinjector.js from OPTIMIZELY_CMS_URL (above)
# to bridge the CMS editor iframe to this app, so no extra var is needed here.

# --- Optional: Optimizely Web Experimentation / Personalization -------------
# Public — ends up in the client snippet URL (https://cdn.optimizely.com/js/<id>.js).
# Leave blank to skip loading the Web snippet entirely.
NEXT_PUBLIC_OPTIMIZELY_WEB_SNIPPET_ID=
