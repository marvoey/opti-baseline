# Optimizely CMS SaaS — copy to .env and fill in real values (.env is gitignored).

# Port the server listens on (npm run dev / npm run start). Defaults to 3009 if unset.
PORT=3009

# Default locale. Serves clean URLs (no /en/ prefix); other CMS-enabled locales
# get a /<segment>/ prefix. Must match the CMS default locale.
OPTIMIZELY_DEFAULT_LOCALE=en

# --- Build-time: pushing content types + generating the locale list ---------
# Used by @optimizely/cms-cli (`npm run config:push`) and scripts/generate-locales.mjs
# (`npm run gen:locales`). Create an API client in CMS admin → Settings → API Clients.
OPTIMIZELY_CMS_URL=https://your-instance.cms.optimizely.com/
OPTIMIZELY_CMS_CLIENT_ID=
OPTIMIZELY_CMS_CLIENT_SECRET=
# Content Management API gateway. Optional — defaults to https://api.cms.optimizely.com.
# Used by the /admin content-type inspector (and the CLI) to read/push content types.
# OPTIMIZELY_CMS_API_URL=https://api.cms.optimizely.com

# --- Runtime: fetching published/preview content via Optimizely Graph -------
# REQUIRED — the app fails fast at startup (lib/env.ts) without this. Found in
# the Graph admin. The gateway URL is optional; the SDK defaults to the value below.
OPTIMIZELY_GRAPH_SINGLE_KEY=
OPTIMIZELY_GRAPH_GATEWAY=https://cg.optimizely.com/content/v2

# Optional. Content is indexed in Optimizely Graph under the real deployed
# domain (_metadata.url.base), never "localhost" — so in local dev (lib/siteHost.ts)
# the request host is swapped for this origin (e.g. https://ontic.optimoey.com)
# to scope Graph lookups to the right site. Without it, local dev falls back to
# scoping by "localhost" itself, which won't match any indexed content.
DEPLOYED_URL=

# Optional. Comma-separated extra hostnames (no scheme, no port) to treat as local
# dev, e.g. an ngrok tunnel: opticoder.ngrok.app. They get the same DEPLOYED_URL
# Graph scoping as localhost (lib/siteHost.ts) and are added to Next's
# allowedDevOrigins (next.config.ts). Restart the dev server after changing it.
DEV_HOSTS=

# --- Preview / on-page editing (app/preview/page.tsx) -----------------------
# The preview route loads communicationinjector.js from OPTIMIZELY_CMS_URL (above)
# to bridge the CMS editor iframe to this app, so no extra var is needed here.

# --- Optional: Optimizely Web Experimentation / Personalization -------------
# Public — ends up in the client snippet URL (https://cdn.optimizely.com/js/<id>.js).
# Leave blank to skip loading the Web snippet entirely.
NEXT_PUBLIC_OPTIMIZELY_WEB_SNIPPET_ID=

# --- Optional: Optimizely Feature Experimentation (server-side) -------------
# Personalises the home page: lib/fx.ts decides flag `ehealth_home_hero`, whose
# variable `cms-saas-content-variation` names the CMS (SaaS) content variation
# (AcaOep / Turning65 / AepSwitcher) to request from Graph. SERVER ONLY - never
# NEXT_PUBLIC_. Use the SDK key of the FX environment you want (Settings ->
# Environments). Leave blank to skip: the site then serves the default content.
# Try it: /?utm_campaign=aca, /?utm_campaign=t65, or /?fx_reset=1 to re-roll the A/B bucket.
OPTIMIZELY_FX_SDK_KEY=

# --- Optional: Mark (Opal) source-file tools (lib/mark-tools) ---------------
# Lets Mark agents list, search, read and edit THIS project's files through
# /api/mark-tools/*. Off unless enabled; dev-only by default; never on Vercel.
# Guide: docs/Mark Source File Tools.md
MARK_TOOLS_ENABLED=false
# Required when enabled (24+ chars). Generate: npm run mark-tools:token
# Paste the same value into Mark's "Bearer Token" field when adding the registry.
MARK_TOOLS_TOKEN=
# Recommended when several projects are registered in Mark: tool names become
# <prefix>_read_source_file, etc. Use a short project slug, e.g. ups, omni, cibc.
MARK_TOOLS_NAME_PREFIX=
# Safety switches. READ_ONLY blocks every write; DEFAULT_DRY_RUN makes edits
# return a diff only unless the agent passes dry_run="false".
MARK_TOOLS_READ_ONLY=false
MARK_TOOLS_DEFAULT_DRY_RUN=false
# Extra comma-separated rules on top of the built-in ones:
#   DENY = path segments never reachable (built in: .git, node_modules, .next, .env*, keys...)
#   READ_ONLY_PATHS = project-relative globs agents can read but not write
#     (built in: lib/mark-tools/**, app/api/mark-tools/**, lockfiles)
# MARK_TOOLS_DENY=
# MARK_TOOLS_READ_ONLY_PATHS=cms/**/*.generated.ts,optimizely.config.mjs
# Optional: limit editable file types, e.g. .ts,.tsx,.css,.json,.md,.mjs
# MARK_TOOLS_ALLOWED_EXTENSIONS=
# Optional: require the bearer token on /api/mark-tools/discovery too.
# MARK_TOOLS_PROTECT_DISCOVERY=false

# --- Optional: password for the internal RFI prep page (/demo/rfi) -----------
# HTTP Basic auth in proxy.ts: any username, this password. Fails closed: when
# unset the page returns 503 for everyone. Set it in Vercel too. The customer-facing
# /demo/rfi-overview is not protected.
RFI_PAGE_PASSWORD=

# --- Optional: password for the /admin content-type inspector ------------------
# Same HTTP Basic auth as RFI_PAGE_PASSWORD (proxy.ts), plus a re-check inside the
# delete action. Fails closed: when unset, /admin returns 503 and deletes are refused.
# Set it in Vercel too.
ADMIN_PASSWORD=
