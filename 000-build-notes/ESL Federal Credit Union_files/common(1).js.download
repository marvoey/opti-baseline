// match Media for equal height initiate after mobile
var mql = window.matchMedia("(min-width: 480px),(min-device-width: 480px),only screen and (-webkit-min-device-pixel-ratio: 2) and (min-width: 480px),only screen and (min--moz-device-pixel-ratio: 2)and(min-width: 480px),only screen and (-o-min-device-pixel-ratio: 2/1) and (min-width: 480px),only screen and (min-device-pixel-ratio: 2) and (min-width: 480px),only screen and (min-resolution: 192dpi) and (min-width: 480px),only screen and (min-resolution: 2dppx)  and (min-width: 480px)");

if (mql.matches) {

    $('.audience-listing .quick-click').addClass('equal-height');

} else {

    $('.audience-listing .quick-click').removeClass('equal-height');
}


