// this approach prevents different toggling of classes if hovered on page load
$(window).on('load', function () {
    $(".main-nav .main > li").hover(
        function () {
            $(this).addClass('active-category');
            $(this).children('ul.mega-menu').addClass('active-mega');
            $(this).parent().addClass('active-menu');
        },
        function () {
            $(this).removeClass('active-category');
            $(this).children('ul.mega-menu').removeClass('active-mega');
            $(this).parent().removeClass('active-menu');
        }
    )
});

