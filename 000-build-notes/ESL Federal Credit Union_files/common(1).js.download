//Hack to stop ios from centering fixed div when focusing on search field
if (navigator.userAgent.match(/(iPod|iPhone|iPad)/)) {
    $('.txtHeaderKeyword').focus(function () {
        var top = $(window).scrollTop();
        setTimeout(function () {
            $(window).scrollTop(top);
        }, 0);
    });
}

//remove the labels that have the X on them when clicked
$(":not(.hp-alert).label.close").click(function () {
    $(this).addClass("visually-hidden");
});

// close alert only if the X icon is clicked 
$('.hp-alert.label.close').on('click', function (event) {
    const parentRect = this.getBoundingClientRect();
    const pseudoStyle = window.getComputedStyle(this, '::before');

    const pseudoLeft = parentRect.width - 25;
    const pseudoTop = 5;
    const pseudoWidth = parseFloat(pseudoStyle.width);
    const pseudoHeight = parseFloat(pseudoStyle.height);

    const clickX = event.clientX - parentRect.left;
    const clickY = event.clientY - parentRect.top;

    if (clickX >= pseudoLeft && clickX <= (pseudoLeft + pseudoWidth) &&
        clickY >= pseudoTop && clickY <= (pseudoTop + pseudoHeight)) {
        $(this).addClass("visually-hidden");
    }
});



