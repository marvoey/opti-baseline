//scroll carousel
$('#carousel-next, #carousel-prev').click(function (e) {
    e.preventDefault();
    var id = e.target.id;
    if (id == 'carousel-next') {
        $('ul.hp-carousel li:first').appendTo('ul.hp-carousel');
    } else {
        $('ul.hp-carousel li:last').prependTo('ul.hp-carousel');
    }
});

//modals
$(document).ready(function () {
    $.fn.modal = function () {
        var centerModal = function (modalBox) {
            modalBox.css('left', ($(window).width() - modalBox.outerWidth()) / 2 + 'px');
            //modalBox.css('top',($(window).height()-modalBox.outerHeight())/ 2 + 'px');
            $('.modalInner').css('max-height', modalBox.height() + 1);
            $('.modalInner img').css('max-height', modalBox.height() + 1);
        };
        $.fn.modal.showModal = function (id) {
            var modalBox = $('.modalContent[id="' + id + '"]');
            var focusedElBeforeShowModal = $(document.activeElement);
            if (modalBox != null) {
                modalBox.addClass('visible').wrapInner("<div class='modalInner' />").append("<a class='modalClose' title='close' href='javascript:void(0)'><span>Close</span></a>");
                $('body').append($("<div></div>").addClass('modalCover'));
                $('.modalCover').click(function () {
                    hideModal();
                });
                $('.modalClose').click(function () {
                    hideModal();
                });
                focusableEls = modalBox.find('a[href], area[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), button:not([disabled]), .dialog-confirm [tabindex="0"]');
                focusableEls.first().focus();
                modalBox.bind('keydown', function (event) {
                    switch (event.keyCode) {
                        case 9: // tab key
                            if (focusableEls.length < 2) {
                                event.preventDefault();
                                break;
                            }
                            var focusedEl = $(document.activeElement);
                            if (event.shiftKey) {
                                // handle backward tab
                                if (focusedEl[0] === focusableEls.first()[0]) {
                                    event.preventDefault();
                                    focusableEls.last().focus();
                                }
                            } else {
                                // handle forward tab
                                if (focusedEl[0] === focusableEls.last()[0]) {
                                    event.preventDefault();
                                    focusableEls.first().focus();
                                }
                            }
                            break;
                        case 27: // esc key
                            event.preventDefault();
                            hideModal();
                            break;
                        default:
                            break;
                    }
                });
                centerModal(modalBox);
            }
            function hideModal() {
                modalBox.removeClass('visible');
                $('.modalCover').remove();
                $('.modalClose').remove();
                //$('.modalInner').replaceWith($('.modalInner').contents());
                focusedElBeforeShowModal.focus();
            }
        }
        $('.modalTrigger').on('click', function (e) {
            e.preventDefault();
            showModal($(this).attr('href'));
            return false;
        });
        $(window).resize(function () {
            centerModal($('.modalContent.visible'));
        });
    };
    $(".modalContent").modal();
});
function showModal(id) {
    $.fn.modal.showModal(id);
}


//make all thumbnail containers equal the height of the tallest one


var rtime = new Date(1, 1, 2000, 12, 00, 00);
var timeout = false;
var delta = 5;
$(window).on('load', function () { // wait for all content and images are loaded
    setEqualHeight();
    $(window).resize(function () {
        rtime = new Date();
        $('.equal-height').css('height', '');
        if (timeout === false) {
            timeout = true;
            setTimeout(resizeEndEqualHeight, delta);
        }
    })
});

function resizeEndEqualHeight() {
    if (new Date() - rtime < delta) {
        setTimeout(resizeEndEqualHeight, delta);
    } else {
        timeout = false;
        setEqualHeight();
    }
}

function setEqualHeight() {
    $('.equal-height').parent().each(
        function () {
            //add if statement so this doesnt happen on mobile?
            var biggestHeight = 0;
            $(this).children('.equal-height').each(
                function () {
                    if ($(this).outerHeight() > biggestHeight) {
                        biggestHeight = $(this).outerHeight();
                    }
                });
            $(this).children('.equal-height').css('height', (biggestHeight));
            //end add if
        });
}


//polyfill form field placeholder text for browsers that don't support it
$(document).ready(function () {
    if (!Modernizr.input.placeholder) {
        if (!("placeholder" in document.createElement("input"))) {
            $("input[placeholder], textarea[placeholder]").each(function () {
                var val = $(this).attr("placeholder");
                if (this.value == "") {
                    this.value = val;
                }
                $(this).focus(function () {
                    if (this.value == val) {
                        this.value = "";
                    }
                }).blur(function () {
                    if ($.trim(this.value) == "") {
                        this.value = val;
                    }
                })
            });

            // Clear default placeholder values on form submit
            $('form').submit(function () {
                $(this).find("input[placeholder], textarea[placeholder]").each(function () {
                    if (this.value == $(this).attr("placeholder")) {
                        this.value = "";
                    }
                });
            });
        }
    }
});


/* Fix for ios not rendering the placeholder element on orientation change ( http://mooki83.tistory.com ) */
$(document).ready(function () {
    function fm_optimizeInput() {
        $("input[placeholder],textarea[placeholder]").each(function () {
            var tmpText = $(this).attr("placeholder");
            if (tmpText != "") {
                $(this).attr("placeholder", "").attr("placeholder", tmpText);
            }
        })
    }
    $(window).bind("orientationchange.fm_optimizeInput", fm_optimizeInput);
});


