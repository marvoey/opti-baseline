var OnlineBanking = {
    SubmitForm: function (url, data) {
        var form = $("<form></form>");

        form.prop("method", "POST");
        form.prop("action", url);

        for (var key in data) {
            if (data.hasOwnProperty(key)) {
                var element = $('<input type="hidden" />');

                element.attr("name", key);
                element.attr("value", data[key]);

                form.append(element);
            }
        }

        form.hide();
        form.appendTo("body");
        form.submit();
        form.remove();
    },

    PersonalLogin: function (form) {
        var username = $("input.username", form).val();
        var password = $("input.password", form).val();

        if (username == '' || username == $("input.username", form).prop("placeholder")) {
            alert('Please enter your Member # / User ID');

            return false;
        }
        else if (password == '') {
            alert('Please enter your password');

            return false;
        }
        else {
            var data = {
                userid: username,
                password: password
            };

            OnlineBanking.SubmitForm("https://eslpersonalbanking.esl.org/tob/live/usp-core/app/initialLogin", data);
        }
    },

    BusinessLogin: function (form) {
        var username = $("input.username", form).val();
        var password = $("input.password", form).val();

        if (username == '' || username == $("input.username", form).prop("placeholder")) {
            alert('Please enter your User ID');
            return false;
        }
        else if ($("div.password", form).is(":visible") && password == '') {
            alert('Please enter your password');
            return false;
        }
        else {
            var data = {
                user_id: username,
                password: ''
            };
            if ($("div.password", form).is(":visible"))
                data.password = password;
            else
                data.forgot_password = true;
            OnlineBanking.SubmitForm("https://eslbusinessbanking.esl.org/ESLFederalCreditUnionOnline/uux.aspx", data); 
        }
    },

    Initialize: function () {
        if (navigator.userAgent.indexOf("Trident") > -1) {
            $("input.placeholder").on("focus", function (event) {
                var textbox = $(this);
                var value = textbox.val();
                var defaultValue = textbox.prop("placeholder");

                if (value === "") {
                    value = defaultValue;

                    textbox.val(defaultValue);
                }

                if (value === defaultValue) {
                    setTimeout(function () {
                        textbox.prop({
                            selectionStart: 0,
                            selectionEnd: 0
                        });
                    }, 100);
                }
            });

            $("input.placeholder").on("blur", function (event) {
                var textbox = $(this);
                var value = textbox.val();
                var defaultValue = textbox.prop("placeholder");

                if ($.trim(value) === "")
                    textbox.val(defaultValue);
            });

            $("input.placeholder").on("keypress", function (event) {
                var textbox = $(this);
                var value = textbox.val();
                var defaultValue = textbox.prop("placeholder");

                if (value === defaultValue)
                    textbox.val("");
            });
        }

        $("input[type='submit']", "div.personal-online-banking-login").on("click", function (event) {
            event.preventDefault();

            var form = $(this).closest("div.personal-online-banking-login");

            OnlineBanking.PersonalLogin(form);
        });

        $("a.forgot-password", "div.business-online-banking-login").on("click", function (event) {
            event.preventDefault();

            var form = $(this).closest("div.business-online-banking-login");

            $("div.password", form).hide();
            $(this).hide();
            $(this).next("span.separator").hide();
            $("input[type='submit']", form).val("Submit");
        });
        $("input[type='submit']", "div.business-online-banking-login").on("click", function (event) {
            event.preventDefault();

            var form = $(this).closest("div.business-online-banking-login");

            OnlineBanking.BusinessLogin(form);
        });

        $("ul.utility-login-content > li > a, ul.login-content > li > a").on("click", function (event) {
            var container = $(this).parent("li");

            $("div.password, a.forgot-password, span.separator", container).show();
            $("input[type='submit']", container).val("Login");
        });
    }
};

$(document).ready(function () {
    OnlineBanking.Initialize();
});

function getRateFeeTimestamp() {
    var now = new Date();
    var rateDateTime = now.toLocaleString();
    return rateDateTime.replace('PM', 'p.m.').replace('AM', 'a.m.');
}

$(document).ready(function () {
    $('time.rate-fee-timestamp').html(getRateFeeTimestamp());

    var elemRatesUploaded = $('#hidRatesUploadedTimestamp');
    if (elemRatesUploaded) $('time.rates-uploaded-timestamp').html(elemRatesUploaded.val());

    var elemPrimeRate = $('#hidPrimeRateDynamic');
    if (elemPrimeRate) $('span.current-prime-rate').html(elemPrimeRate.val());

    var elemPrimeRate = $('#hidPrimeRateDateDynamic');
    if (elemPrimeRate) $('span.current-prime-rate-date').html(elemPrimeRate.val());

    var elemBranchCount = $('#hidBranchCountDynamic');
    if (elemBranchCount) $('span.current-branch-count').html(elemBranchCount.val());
});

$(document).ready(function () {
    $('section.FAQ .question').click(function () {
        if ($(this).closest('section.FAQ').find('.answer').is(':visible')) {
            var linkText = $(this).text();
            ga('send', 'event', 'accordion', 'click', linkText);
        }
    })
    $('section.avoid-fees .hiddenTriggerClick').click(function () {
        if ($(this).closest('section.avoid-fees').find('.hiddenContent').is(':visible')) {
            var linkText = $(this).text();
            ga('send', 'event', 'accordion', 'click', linkText);
        }
    })
});



/* Instructions:
1. Define the main element you want moved (theElement)
2. Define the container you want the element moved to (destination: '.destinationContainer')
3. Define the breakpoint at which you want the element moved in pixels (mediaQuery: 1000) 
    3a. This is optional - the default is 1023
4. Define the modifier class you want added to the element while it is moved (movedClass: 'someClassName')
    4a. This is optional - the default is 'is-moved'
    5. Define whether you would like the element to be prepended (added to beginning)
    or appended (added to end) of destination container

FULL EXAMPLE:
$('.navCallout').retach({
    destination:'.globals-mobile', 
    mediaQuery: 641,
    movedClass: 'navCallout-mobile',
    prependAppend: 'prepend'
});

Let's break this down:

//.navCallout is what we want to move around
$('.navCallout').retach({

    //We specify that the element should be moved to the div with the class of .globals-mobile
    destination: '.globals-mobile',

    //This element should be moved while screen width is LESS THAN 641px wide
    mediaQuery: 641,

    //We add the class of "navCallout-mobile" to the element while it is moved from it's original location
    movedClass: 'navCallout-mobile',

    //instead of appending the element to the container, we will prepend it
    prependAppend: 'prepend'
});

HEADER SPECIFIC EXAMPLE:
Let's say different headers have different elements and we want some to appear in the global-mobiles drawer

    //for the element we want to move, just add the classname of the appropriate header
    $('.headerMain--franchise .locSearch').retach({
        destination:'.globals-mobile', 
        mediaQuery: 641,
        movedClass: 'locSearch-mobile',
        prependAppend: 'prepend'
    });

*/


